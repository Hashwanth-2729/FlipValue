{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": false,
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "flipvalue-api", "region": "asia-south1" } },
      { "source": "/v1/**", "run": { "serviceId": "flipvalue-api", "region": "asia-south1" } },
      { "source": "/admin/api/**", "run": { "serviceId": "flipvalue-api", "region": "asia-south1" } },
      { "source": "/openapi.json", "run": { "serviceId": "flipvalue-api", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
