# Local development settings. Copy to .env (never committed). In Cloud Run, secrets come from Secret Manager and
# the rest from --set-env-vars; see docs/ENVIRONMENT.md for every variable and where it is set in production.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# development | production. Production: refuses mock data and SQLite, requires FLIPVALUE_HASH_SALT, sends HSTS.
FLIPVALUE_ENV=development

# SQLite for local development. Production (Cloud SQL via the Cloud Run connector):
# postgresql+psycopg://flipvalue:<password>@/flipvalue?host=/cloudsql/<project>:<region>:<instance>
FLIPVALUE_DATABASE_URL=sqlite:///var/flipvalue.db
FLIPVALUE_DB_POOL_SIZE=5
FLIPVALUE_DB_MAX_OVERFLOW=2

# Partner and admin keys (comma-separated, each >= 32 chars). Keys can also be issued into the database with
# `python -m flipvalue keys create --role partner|admin`.
FLIPVALUE_API_KEYS=
FLIPVALUE_ADMIN_KEYS=

# Salt for hashing client IPs (>= 32 chars). Required in production.
FLIPVALUE_HASH_SALT=

# Limits
FLIPVALUE_RATE_LIMIT_PER_MIN=60
FLIPVALUE_PUBLIC_RATE_LIMIT_PER_MIN=30
FLIPVALUE_PUBLIC_GLOBAL_RATE_LIMIT_PER_MIN=600
FLIPVALUE_MAX_BODY_BYTES=16384
FLIPVALUE_REQUEST_TIMEOUT_S=5
FLIPVALUE_FRESHNESS_DAYS=180

# Exact website origins allowed to call the API from another origin (comma-separated, https in production, no '*').
# Leave empty when the website reaches the API through Firebase Hosting rewrites (same origin).
FLIPVALUE_CORS_ORIGINS=

# Behind proxies (Cloud Run, Firebase Hosting): trust X-Forwarded-For and take the entry PROXY_HOPS from the right.
FLIPVALUE_TRUST_PROXY=false
FLIPVALUE_PROXY_HOPS=1

# Built website served by the API itself (local use). Empty = frontend/dist if it exists.
FLIPVALUE_FRONTEND_DIST=

# Only for local production-like tests; never set in a real deployment.
FLIPVALUE_ALLOW_SQLITE_IN_PRODUCTION=false

# Server entry point (python -m flipvalue serve): port supplied by the platform.
PORT=8080

# --- Marketplace providers (docs/DATA_SOURCES.md). Empty = not configured; never exposed to the browser. -------
# Flipkart Affiliate Program: tracking id + API token (approved affiliates only).
FLIPVALUE_FLIPKART_AFFILIATE_ID=
FLIPVALUE_FLIPKART_AFFILIATE_TOKEN=
# Amazon.in Creators API (successor of PA-API 5): approved Associates account. The token URL depends on the
# credential version Amazon assigns (e.g. https://api.amazon.co.uk/auth/o2/token for v3.x EU/IN) - confirm it.
FLIPVALUE_AMAZON_CREDENTIAL_ID=
FLIPVALUE_AMAZON_CREDENTIAL_SECRET=
FLIPVALUE_AMAZON_PARTNER_TAG=
FLIPVALUE_AMAZON_TOKEN_URL=
FLIPVALUE_PROVIDER_TIMEOUT_S=8
# Minimum minutes between retrievals per provider and product (>= 15). Raise it to what each provider's terms allow.
FLIPVALUE_PROVIDER_MIN_REFRESH_MINUTES=60
# Offers retrieved within this many hours are "fresh"; older than MAX_AGE_DAYS they are history only.
FLIPVALUE_OFFER_FRESH_HOURS=24
FLIPVALUE_OFFER_MAX_AGE_DAYS=14

# --- Developer platform ------------------------------------------------------------------------------------
# open | closed (self-service sign-up; closed = operator-issued keys only)
FLIPVALUE_DEVELOPER_SIGNUP=open
FLIPVALUE_DEVELOPER_RATE_LIMIT_PER_MIN=60
FLIPVALUE_DEVELOPER_DAILY_QUOTA=1000
FLIPVALUE_MAX_KEYS_PER_ACCOUNT=5
# Session cookies are Secure automatically in production; set true to force it elsewhere (e.g. HTTPS staging).
FLIPVALUE_SECURE_COOKIES=false
