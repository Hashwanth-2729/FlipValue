# Copy to frontend/.env.production (or set in CI) before `npm run build`. Values here end up in the public bundle:
# never put secrets or API keys in VITE_ variables.

# Empty (recommended with Firebase Hosting): the website calls /api on its own origin and Hosting rewrites it to
# Cloud Run. Set to an https origin only if the website and the API are on different origins.
VITE_API_BASE_URL=
